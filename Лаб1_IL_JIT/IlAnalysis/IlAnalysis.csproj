<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Debug-конфигурация обязательна: GetMethodBody() не возвращает
         тело метода, если сборка оптимизирована компилятором Release. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Даёт тестовому проекту доступ к internal-классам (Task1_BasicMethods,
         DynamicMethodsDemo, IlInspector) без изменения их видимости на public. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>IlJitLab1.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
