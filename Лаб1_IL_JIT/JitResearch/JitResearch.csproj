<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Release обязателен для BenchmarkDotNet: в Debug JIT не применяет
         оптимизации, и замеры производительности будут недостоверны. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Даёт тестовому проекту доступ к internal-классам (ColdStartDemo,
         JitVisualization) без изменения их видимости на public. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>IlJitLab1.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
